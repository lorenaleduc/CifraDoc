# Credenciais fictícias de laboratório. Copie para .env se quiser personalizá-las.
# O servidor lê as senhas ao criar cada conta no SQLite. Alterar .env depois não
# troca as senhas das contas existentes, mesmo se os contêineres forem recriados.
DEMO_ADMIN_PASSWORD=AdminLab!2026
DEMO_USER_PASSWORD=AlunoLab!2026
DEMO_OTHER_PASSWORD=ColegaLab!2026
